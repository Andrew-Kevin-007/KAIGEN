# Set after the contracts are deployed (S1). Until then the app shows "not deployed yet".
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.near.org
NEXT_PUBLIC_KIZASHI_ID=
NEXT_PUBLIC_DRILL_KIZASHI_ID=

# Server-only. JWT for the 1Click API (request one from the NEAR Intents team). Without it, the top-up page says so.
ONECLICK_JWT=
ONECLICK_BASE_URL=https://1click.chaindefuser.com
NEXT_PUBLIC_NETWORK=mainnet
# Server-only. The code hash (base58) of the deployed Kizashi. Top-ups are refused until it is set, and unless
# the recipient account runs exactly this code.
KIZASHI_CODE_HASH=
# Server-only. Set to 1 only to rehearse top-ups against testnet contracts. Leave unset in production.
TOPUP_ALLOW_TESTNET=
# Server-only. How many proxies sit in front of this server and append to x-forwarded-for. The rate limit on the
# top-up routes uses the address the last of them saw.
TRUSTED_PROXY_HOPS=1
# Set to 1 to switch on the Create vault page. Leave unset until gates G1 and G3 have passed on mainnet.
NEXT_PUBLIC_VAULT_CREATE=
